{
  "extends": "expo/tsconfig.base",
    "compilerOptions": {
      "target": "esnext",
      "lib": ["es6", "dom"],
      "allowJs": true,
      "jsx": "react-native",
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    },
}

